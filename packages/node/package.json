{
  "name": "@geotoolcn/core",
  "version": "3.1.0-rc.1",
  "description": "Offline geocoding and reverse geocoding for Chinese administrative regions",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
